# Copia questo file in apps/studio/.env.local e apps/genitori/.env.local
# Valori da: Supabase Dashboard → Project Settings → API (oppure output di "supabase start").
# La chiave "anon"/"publishable" è pubblica per definizione: la sicurezza la fanno le policy RLS.
# NON mettere MAI qui la service_role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=incolla-qui-la-anon-key
